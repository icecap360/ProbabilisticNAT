{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "extract_imagenet_feature",
            "type": "debugpy",
            "request": "launch",
            "program": "extract_imagenet_feature.py",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "train",
            "type": "debugpy",
            "request": "launch",
            "program": "train.py",
            "args": ["--config", "configs/AutoNAT_L.yaml", "--gen_steps", "8", 
            "--searched_strategy", "configs/AutoNAT_L-T8_strategy.yaml", "--pretrained_path", "assets/nnet_ema.pth", "--mode", "eval", "--eval_n", "50000"],
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Train AutoNAT Distributed",
            "type": "python",
            "request": "launch",
            "module": "torch.distributed.run",
            "args": [
                "--nproc_per_node=1",
                "--rdzv_backend=c10d",
                "--rdzv_endpoint=localhost:0",
                "train.py",
                "--config",
                "configs/AutoNAT_L.yaml",
                "--gen_steps",
                "8",
                "--searched_strategy",
                "configs/AutoNAT_L-T8_strategy.yaml",
                "--pretrained_path",
                "assets/nnet_ema.pth",
                "--mode",
                "eval",
                "--eval_n",
                "5000"
            ],
            "env": {
                "ACCELERATE_MIXED_PRECISION": "fp16",
                "CUDA_VISIBLE_DEVICES": "2"
            },
            "console": "integratedTerminal",
            "justMyCode": true,
            "cwd": "${workspaceFolder}"
        }
    ]
}